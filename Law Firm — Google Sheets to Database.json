    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nreturn rows.map(item => {\n  const d = item.json;\n  // Normalise date fields\n  const parseDate = (val) => {\n    if (!val) return null;\n    const d = new Date(val);\n    return isNaN(d) ? null : d.toISOString().split('T')[0];\n  };\n  return {\n    json: {\n      case_id:        (d['Case ID'] || '').toString().trim(),\n      client_name:    (d['Client Name'] || '').toString().trim(),\n      case_type:      (d['Case Type'] || '').toString().trim(),\n      status:         (d['Status'] || '').toString().trim().toLowerCase(),\n      assigned_to:    (d['Assigned Attorney'] || '').toString().trim(),\n      filed_date:     parseDate(d['Filed Date']),\n      hearing_date:   parseDate(d['Hearing Date']),\n      notes:          (d['Notes'] || '').toString().trim(),\n      last_synced_at: new Date().toISOString()\n    }\n  };\n});"
      },
